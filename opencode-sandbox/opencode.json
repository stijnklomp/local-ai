{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "~/.config/opencode/skills/docker-runtime/SKILL.md",
    "CRITICAL: When calling agentmemory MCP tools, always provide 'concepts' and 'files' as explicit structured arrays, never as flat strings or comma-separated text.",
    "agentmemory runs on the host and is not guaranteed to be available: if it is offline, the MCP tools fall back to a sandbox-local store that never syncs to the host, so memory persistence is not guaranteed. This is by design; still use the tools normally."
  ],
  "model": "opencode-go/deepseek-v4-flash",
  "permission": {
    "*": "allow",
    "agentmemory_memory_slot_*": "deny",
    "agentmemory_memory_graph_query": "deny",
    "agentmemory_memory_relations": "deny"
  },
  "mcp": {
    "agentmemory": {
      "type": "local",
      "command": ["agentmemory", "mcp"],
      "environment": {
        "AGENTMEMORY_URL": "http://host.docker.internal:3111"
      },
      "enabled": true
    }
  },
  "provider": {
    "opencode-go": {
      "models": {
        "deepseek-v4-flash": {
          "options": {
            "reasoningEffort": "max"
          }
        }
      }
    },
    "openrouter": {
      "models": {
        "auto": {
          "name": "Auto Router (dynamic)"
        }
      }
    },
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://172.17.0.1:11434/v1"
      },
      "models": {
        "mistral-nemo:12b": {
          "name": "Mistal Nemo (12B) General (Nvidia GPU optimized)"
        },
        "qwen2.5-coder:14b": {
          "name": "Qwen 2.5 (14B) Coding"
        },
        "qwen2.5:14b": {
          "name": "Qwen 2.5 (14B) General"
        },
        "deepseek-r1:32b": {
          "name": "Deepseek (32B) Reasoning"
        }
      }
    },
    "llama-server": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp (local, RTX 5080)",
      "options": {
        "baseURL": "http://172.17.0.1:8080/v1"
      },
      "models": {
        "Qwen3.8-27B-UD-IQ4_XS.gguf": {
          "name": "Qwen 3.8 (27B) IQ4_XS, 256K ctx, MTP"
        }
      }
    }
  },
  "enabled_providers": [
    "ollama",
    "llama-server",
    "opencode",
    "opencode-go",
    "openrouter"
  ],
  "autoupdate": false,
  "watcher": {
    "ignore": ["node_modules/**", "dist/**"]
  }
}
