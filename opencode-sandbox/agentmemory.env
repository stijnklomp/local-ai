AGENTMEMORY_LLM_PROVIDER=openai

# agentmemory's client sends no temperature/top_p, and its XML parser rejects a
# literal '&'. Local models copy shell commands containing '&&' verbatim, so
# compression fails validation. scripts/agentmemory-ollama-proxy.mjs sits in
# front of Ollama, forces greedy sampling and escapes bare '&' in responses.
# Start it on the host before starting agentmemory (see README).
OPENAI_MODEL=mistral-nemo:12b # Size: 7.1GB - Context: 128K	- Headroom: ~8.9GB | Faster speeds. Well optimized for NVidia hardware

OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://127.0.0.1:11435/v1
OPENAI_TIMEOUT_MS=600000

# Semantic recall through the same proxy. Qwen3-Embedding-0.6B is multilingual
# (100+ languages), 1024 dims, and reads up to 32K tokens. sync-config.sh pulls
# it on the host if missing.
EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=qwen3-embedding:0.6b
OPENAI_EMBEDDING_DIMENSIONS=1024
AGENTMEMORY_VECTOR_BACKFILL=all
# Whole-store backfill queues up to this many observations per boot. Keep it
# above the store size so one start re-embeds everything; the internal batch
# size still controls GPU memory.
AGENTMEMORY_VECTOR_BACKFILL_MAX=100000
# One-time: the old index holds 768-dim vectors, so the 1024-dim provider makes
# agentmemory refuse to start. This discards them and rebuilds from the store.
# Remove after the 1024-dim rebuild has completed.
AGENTMEMORY_DROP_STALE_INDEX=true

CONSOLIDATION_INTERVAL_MS=7200000
AGENTMEMORY_AUTO_COMPRESS=true
GRAPH_EXTRACTION_ENABLED=false
SUMMARIZE_CHUNK_SIZE=20
SUMMARIZE_CHUNK_CONCURRENCY=1
