AGENTMEMORY_LLM_PROVIDER=openai

# agentmemory's client sends no temperature/top_p, and its XML parser rejects a
# literal '&' and any raw '<' in text fields. Local models copy `&&` and code
# like `a < b` verbatim, so compression and summaries fail validation.
# scripts/agentmemory-ollama-proxy.mjs sits in front of Ollama, forces greedy
# sampling and escapes those characters in responses. Start it on the host
# before starting agentmemory (see README).
OPENAI_MODEL=mistral-nemo:12b # Size: 7.1GB - Model supports 128K, but this Ollama serves 16K	- Headroom: ~8.9GB | Faster speeds. Well optimized for NVidia hardware

OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://127.0.0.1:11435/v1
OPENAI_TIMEOUT_MS=600000

# Semantic recall through the same proxy. Qwen3-Embedding-0.6B is multilingual
# (100+ languages), 1024 dims, and reads up to 32K tokens. sync-config.sh pulls
# it on the host if missing.
EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=qwen3-embedding:0.6b
OPENAI_EMBEDDING_DIMENSIONS=1024
AGENTMEMORY_VECTOR_BACKFILL=all
# Whole-store backfill queues up to this many observations per boot. Keep it
# above the store size so one start re-embeds everything; the internal batch
# size still controls GPU memory.
AGENTMEMORY_VECTOR_BACKFILL_MAX=100000

CONSOLIDATION_INTERVAL_MS=7200000
AGENTMEMORY_AUTO_COMPRESS=true
# agentmemory silently rejects new observations once a session hits this many
# (default 500); the rejected events pile up as dead letters. Long OpenCode
# sessions exceed 500 routinely. 0 would be uncapped; 5000 keeps a hard ceiling.
MAX_OBS_PER_SESSION=5000
GRAPH_EXTRACTION_ENABLED=false
# Summaries compress observations in chunks. Measured on this store: ~360 chars
# (~90 tokens) of prompt per compressed observation, so 60 observations is
# ~5.5k tokens; that took 12.7s on mistral-nemo:12b and produced valid summary
# XML. The served context is 16K, so 60 leaves room without losing detail.
# Keep one chunk in flight: parallel chunks on a local GPU only add contention.
SUMMARIZE_CHUNK_SIZE=60
SUMMARIZE_CHUNK_CONCURRENCY=1
